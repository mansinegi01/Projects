<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../components/linkcss.ejs') %>
        <title>Document</title>
</head>

<body>
    <%- include('../components/nav.ejs') %>
        <% if (locals.user) { %>
            <div class="card" style="width: 18rem;">
                <img src="<%= blog.coverImage %>" class="card-img-top" style="width: 286px;" alt="Image not found">
                <div class="card-body">
                    <h5 class="card-title">
                        <%= blog.title %>
                    </h5>
                    <p class="card-text">
                        <%= blog.body %>
                    </p>
                </div>

            </div>

            <% } %>
                <div class="form-floating " style="position: relative; top: 30px;">
                    <% if (locals.comments) { %>
                        <form action="/blogg/comments/<%= blog._id %>" method="post">
                            <h2>Comments (<%= comments.length %>)</h2>

                            <textarea class="form-control" placeholder="Leave a comment here" id="floatingTextarea"
                                name="content"></textarea>

                            <button type="submit" class="btn btn-success btn-pr"
                                style="position: relative; top: 10px;left: 0px;">Submit</button>
                </div>
                </form>
                <% } %>
                
                <div>
                    <% comments.forEach(comment => { %>
                     <div class="" style="position: relative ; top:50px"><textarea class="form-control" placeholder="<%= comment.content %>" id="floatingTextarea"
                        name="content"></textarea>
                    <% }) %>
                </div>
                    <%- include('../components/linkscript.ejs') %>
</body>

</html>