<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('../components/linkcss.ejs') %>
    <title>Document</title>
</head>

<body>

  <%- include('../components/nav.ejs') %>

    <% if (locals.msg) { %>
      <div class="alert alert-primary d-flex align-items-center" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2"
          viewBox="0 0 16 16" width="16" height="16" role="img" aria-label="Warning:">

          <path
            d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
        </svg>
        <div>
          <%= msg %>
        </div>
      </div>
      <% } %>
        <form action="/user/signin" method="post">
          <div class="mb-3 ">

            <div class="mb-3 row">

              <div class="mb-3 row">
                <label for="email" class="col-sm-2 col-form-label ">Email</label>
                <div class="col-sm-10">
                  <input type="email" class="form-control" name="email">
                </div>
              </div>

              <div class="mb-3 row">
                <label for="password" class="col-sm-2 col-form-label ">Password</label>
                <div class="col-sm-10">
                  <input type="password" class="form-control" name="password">
                </div>
              </div>
            </div>

            <button type="submit" class="btn btn-success">Submit</button>

        </form>
        <%- include('../components/linkscript.ejs') %>
</body>

</html>