<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../components/linkcss.ejs') %>
    <title>Document</title>
</head>
<body>
    <%- include('../components/nav.ejs') %>
    <div class="mt-3" style="display: flex; flex-direction: row; flex-wrap: wrap; gap: 4; justify-content: space-around;">
        <% blogs.forEach(blog => { %>
            <div class="card" style="width: 18rem; height: 500px; overflow: hidden; position: relative;">
                <img src="<%= blog.coverImage %>" style="width: 286px; height: 250px;" class="card-img-top" alt="Image not found">
                <div class="card-body">
                  <h5 class="card-title"><%= blog.title %></h5>
                  <p class="card-text"><%= blog.body %></p>
                </div>
            </div>
            <button type="submit" class="btn btn-primary" style="height: 40px; position: relative; right: 290px; top: 455px;"><a style="color :whitesmoke ;text-decoration: none;  display: flex; justify-content: space-around;"  href="/blogg/<%= blog._id %>">View</a></button>
            <% }) %>

    </div>
    <%- include('../components/linkscript.ejs') %> 
</body>
</html>